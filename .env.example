# REQUIRED: Secret key used to sign JWT tokens (minimum 32 characters)
JWT_SECRET=your_32_character_minimum_jwt_secret_here

# REQUIRED: A globally unique S3 bucket name for imports
AWS_S3_IMPORT_BUCKET_NAME=your_globally_unique_bucket_name_here

# OPTIONAL: Token expiration times in milliseconds
# Default access expiration: 900000 (15 minutes)
JWT_ACCESS_EXPIRATION=900000
# Default refresh expiration: 604800000 (7 days)
JWT_REFRESH_EXPIRATION=604800000

# OPTIONAL: Allowed CORS origins, comma separated
# Default: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OPTIONAL: AWS Region for your deployment
# Default: ap-south-1
AWS_REGION=ap-south-1